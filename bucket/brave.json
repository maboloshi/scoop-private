{
    "version": "1.96.60",
    "description": "Secure, Fast & Private Web Browser with Adblocker",
    "homepage": "https://brave.com",
    "license": {
        "identifier": "Freeware,BSD-3-Clause,GPL-3.0-only,...",
        "url": "https://github.com/brave/brave-browser/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/brave/brave-browser/releases/download/v1.96.60/brave-v1.96.60-win32-x64.zip",
            "hash": "e728eee449a06a89bed0eae5be6950571a90e9c4c20f97cbd9190423ae026b8b"
        }
    },
    "bin": [
        [
            "brave.exe",
            "brave"
        ]
    ],
    "shortcuts": [
        [
            "brave.exe",
            "Brave",
            "--force-device-scale-factor=1.5"
        ]
    ],
    "post_install": [
        "# 数据迁移",
        "$runtimeCache = \"$env:LocalAppData\\BraveSoftware\\Brave-Browser\\User Data\"",
        "$runtimeCachePersist = \"$persist_dir\\User Data\"",
        "if (Test-Path $runtimeCachePersist) {",
        "    Remove-Item -Path $runtimeCache -Force -Recurse -ErrorAction SilentlyContinue",
        "} elseif (Test-Path $runtimeCache) {",
        "    Move-Item -Path $runtimeCache -Destination $runtimeCachePersist -Force",
        "}",
        "New-DirectoryJunction $runtimeCache $runtimeCachePersist | Out-Null",
        "# 分发缩放设置脚本，供用户手动运行",
        "Copy-Item \"$bucketsdir\\$bucket\\scripts\\$app\\Set-Brave-Scale.ps1\" \"$dir\""
    ],
    "notes": [
        "Brave 默认程序启动缩放参数需手动设置（Windows 的 UserChoice 保护不允许脚本自动完成）。",
        "步骤：",
        "  1. 打开 设置 > 应用 > 默认应用，将 Brave 设为默认浏览器。",
        "  2. 运行脚本: $dir\\Set-Brave-Scale.ps1",
        "     或右键该文件 > 使用 PowerShell 运行。",
        "脚本作用：为 BraveHTML / BraveFile 的 shell\\open\\command 追加 --force-device-scale-factor=1.5。",
        "如需改缩放比例，编辑脚本顶部的 $scale 变量。"
    ],
    "post_uninstall": [
        "# 删除数据软连接",
        "$runtimeCache = \"$env:LocalAppData\\BraveSoftware\\Brave-Browser\\User Data\"",
        "Remove-Item -Path $runtimeCache -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "persist": "User Data",
    "checkver": {
        "url": "https://brave-browser-downloads.s3.brave.com/latest/release-windows-x64.version",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/brave/brave-browser/releases/download/v$version/brave-v$version-win32-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
